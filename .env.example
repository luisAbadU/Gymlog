# Copia este archivo a .env y cambia los valores. .env nunca se sube al repositorio.

# PostgreSQL (lo usa docker compose para crear la base de datos)
POSTGRES_USER=gymlog
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=gymlog

# App. Para correr la app fuera de Docker (uv run uvicorn) se usa esta URL;
# dentro de Docker Compose se reemplaza por una que apunta al servicio "db".
DATABASE_URL=postgresql+psycopg://gymlog:cambia-esta-contrasena@127.0.0.1:5432/gymlog
APP_ENV=development
LOG_LEVEL=INFO
